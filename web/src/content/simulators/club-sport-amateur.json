{
  "slug": "club-sport-amateur",
  "activity": "club de sport amateur",
  "intro": "Tarifs réels du barème SACEM 2026 (autorisation n° 84). Forfait par licencié selon importance musique × animations.",
  "questions": [
    {
      "id": "licencies",
      "label": "Nombre de licenciés",
      "type": "number",
      "default": 120,
      "min": 1,
      "max": 5000,
      "step": 1,
      "unit": "licenciés"
    },
    {
      "id": "niveau",
      "label": "Importance de la musique",
      "type": "select",
      "default": 1,
      "options": [
        { "value": 1, "label": "Niveau 1, Fond sonore (hors pratique sportive)" },
        { "value": 2, "label": "Niveau 2, Accompagnement (ambiance, jingles, DJ, fanfare)" },
        { "value": 3, "label": "Niveau 3, Synchronisation (danse, GRS, patinage, nat. sync.)" }
      ]
    },
    {
      "id": "animations",
      "label": "Animations dans l'année (soirées, remises de médailles, retransmissions…)",
      "type": "select",
      "default": 3,
      "options": [
        { "value": 1, "label": "1 animation" },
        { "value": 3, "label": "Jusqu'à 3" },
        { "value": 6, "label": "Jusqu'à 6" }
      ]
    },
    {
      "id": "domaine_public_majoritaire",
      "label": "Plus de 50 % des licenciés pratiquent sur domaine public (-50 %)",
      "type": "boolean",
      "default": false,
      "help": "Cas typique : danse classique / ballet."
    },
    {
      "id": "tarif_reduit",
      "label": "Je bénéficie du tarif réduit (contrat général SACEM signé dans les 15 jours)",
      "type": "boolean",
      "default": false
    }
  ],
  "compute": {
    "kind": "composite",
    "op": "max",
    "parts": [
      {
        "kind": "formula",
        "expr": "licencies * (niveau == 1 ? (animations == 1 ? 0.57 : animations == 3 ? 1.14 : 1.93) : niveau == 2 ? (animations == 1 ? 1.14 : animations == 3 ? 2.28 : 2.56) : (animations == 1 ? 2.51 : animations == 3 ? 3.01 : 3.79))"
      },
      {
        "kind": "lookup",
        "rows": [
          { "match": { "animations": 1 }, "value": 140.15 },
          { "match": { "animations": 3 }, "value": 212.96 },
          { "match": {}, "value": 425.91 }
        ]
      }
    ],
    "modifiers": [
      { "kind": "multiply", "value": 0.5, "when": { "domaine_public_majoritaire": true } },
      { "kind": "multiply", "value": 0.8, "when": { "tarif_reduit": true } }
    ]
  },
  "spre": {
    "compute": {
      "kind": "formula",
      "expr": "sacem * 0.65",
      "min": 110.60
    }
  },
  "footnote": "SACEM au tarif général par défaut. Minimum annuel par club appliqué (115,25 € à 425,91 € selon animations). Réveillon, spectacles payants > 200 entrées, bar-restaurant avec animation propre : autres barèmes."
}
